+class TestDocMap(unittest.TestCase):
+    """V3 board 5.1: the composed-doc source tuples externalized to
+    sections/documentation/doc_map.json (seed-then-disk-wins + visible
+    fallback), with the default map rendering byte-identically."""
+
+    def setUp(self):
+        self.app_dir = tempfile.mkdtemp()
+        self.orch_dir = tempfile.mkdtemp()  # isolated: never touches the repo map
+        self.phases = [("prompt_contract", "Prompt Contract"),
+                       ("app_features", "App Features"),
+                       ("design_discussion", "Design Discussion"),
+                       ("tech_specs", "Tech Specs"),
+                       ("final_review", "Final Review"),
+                       ("build_verification", "Build Verification")]
+        self.outputs = {"prompt_contract": "PC.", "design_discussion": "DD.",
+                        "final_review": "FR."}
+
+    def _map_path(self):
+        return os.path.join(self.orch_dir, "sections", "documentation",
+                            "doc_map.json")
+
+    def _read(self, *parts):
+        with open(os.path.join(*parts), encoding="utf-8") as fh:
+            return fh.read()
+
+    def _read_json(self, path):
+        with open(path, encoding="utf-8") as fh:
+            return json.load(fh)
+
+    def test_seed_then_disk_wins(self):
+        # First load with no file on disk seeds the built-in default and returns
+        # it; the file now exists and is a re-load-able copy of the built-in map.
+        self.assertFalse(os.path.exists(self._map_path()))
+        m = docs.load_doc_map(self.orch_dir)
+        self.assertTrue(os.path.exists(self._map_path()))
+        self.assertEqual([d["doc_id"] for d in m["docs"]],
+                         ["prd", "technical_architecture", "qa_report"])
+        self.assertEqual(self._read_json(self._map_path()),
+                         docs._builtin_doc_map())
+
+    def test_seed_never_clobbers_existing(self):
+        os.makedirs(os.path.dirname(self._map_path()))
+        custom = docs._builtin_doc_map()
+        custom["docs"][0]["sources"] = ["prompt_contract"]
+        with open(self._map_path(), "w", encoding="utf-8") as fh:
+            json.dump(custom, fh)
+        # A subsequent load must NOT re-seed over the user's edited file.
+        m = docs.load_doc_map(self.orch_dir)
+        self.assertEqual(m["docs"][0]["sources"], ["prompt_contract"])
+
+    def test_default_map_byte_parity(self):
+        # write_project_docs off the seeded default map == direct renders using
+        # the original module constants + intros (the externalization changed
+        # nothing observable).
+        written = docs.write_project_docs(
+            self.app_dir, "Demo", self.phases, self.outputs,
+            workflow_name="app_build", verify_summary="VERIFIED (ok)",
+            orch_dir=self.orch_dir)
+        self.assertIn("docs/PRD.md", written)
+
+        def rd(fn):
+            return self._read(self.app_dir, "docs", fn)
+        self.assertEqual(rd("PRD.md"), docs.render_composed_doc(
+            "Demo", "Product Requirements (PRD)", docs.PRD_SOURCES,
+            self.phases, self.outputs, intro=docs._PRD_INTRO))
+        self.assertEqual(rd("TECHNICAL_ARCHITECTURE.md"), docs.render_composed_doc(
+            "Demo", "Technical Architecture", docs.ARCH_SOURCES,
+            self.phases, self.outputs, intro=docs._ARCH_INTRO))
+        self.assertEqual(rd("QA_REPORT.md"), docs.render_qa_report(
+            "Demo", self.phases, self.outputs, "VERIFIED (ok)"))
+
+    def test_disk_override_changes_sources_without_code(self):
+        # Editing the on-disk map changes which phases feed a doc — no code change.
+        m = docs._builtin_doc_map()
+        m["docs"][0]["sources"] = ["final_review"]  # PRD now sourced from review
+        os.makedirs(os.path.dirname(self._map_path()))
+        with open(self._map_path(), "w", encoding="utf-8") as fh:
+            json.dump(m, fh)
+        docs.write_project_docs(self.app_dir, "Demo", self.phases, self.outputs,
+                                orch_dir=self.orch_dir)
+        prd = self._read(self.app_dir, "docs", "PRD.md")
+        self.assertIn("## Final Review", prd)
+        self.assertNotIn("## Prompt Contract", prd)
+
+    def test_doc_skipped_when_no_source_phase_exists(self):
+        # A doc whose sources are all absent from the workflow is still skipped
+        # (returns None), never emitted empty or fabricated — via the map path.
+        audit_phases = [("recon", "Recon"), ("report", "Report")]
+        written = docs.write_project_docs(
+            self.app_dir, "Demo", audit_phases, {"recon": "x"},
+            workflow_name="audit", orch_dir=self.orch_dir)
+        self.assertNotIn("docs/PRD.md", written)
+        self.assertFalse(os.path.exists(
+            os.path.join(self.app_dir, "docs", "PRD.md")))
+
+    def test_na_line_preserved_for_unrun_source_phase(self):
+        # A source phase present but never run still renders the exact _NA line.
+        docs.write_project_docs(self.app_dir, "Demo", self.phases, self.outputs,
+                                orch_dir=self.orch_dir)
+        prd = self._read(self.app_dir, "docs", "PRD.md")
+        self.assertIn("## App Features", prd)   # present in workflow
+        self.assertIn(docs._NA, prd)            # but never ran -> N/A verbatim
+
+    def test_corrupt_map_falls_back_with_banner(self):
+        # A malformed doc_map.json must NOT crash and must NOT fall back
+        # silently: built-in defaults are used AND on_warn fires.
+        os.makedirs(os.path.dirname(self._map_path()))
+        with open(self._map_path(), "w", encoding="utf-8") as fh:
+            fh.write("{ this is not valid json ]")
+        warnings = []
+        m = docs.load_doc_map(self.orch_dir, on_warn=warnings.append)
+        self.assertEqual(m, docs._builtin_doc_map())
+        self.assertEqual(len(warnings), 1)
+        self.assertIn("doc_map.json", warnings[0])
+
+    def test_valid_json_but_no_docs_falls_back_with_banner(self):
+        # Valid JSON that lacks a usable docs[] is a malformed map, not a crash.
+        os.makedirs(os.path.dirname(self._map_path()))
+        with open(self._map_path(), "w", encoding="utf-8") as fh:
+            json.dump({"schema_version": 1, "docs": []}, fh)
+        warnings = []
+        m = docs.load_doc_map(self.orch_dir, on_warn=warnings.append)
+        self.assertEqual(m, docs._builtin_doc_map())
+        self.assertEqual(len(warnings), 1)
+
+    def test_blueprint_ships_11_categories_40_slots(self):
+        m = docs.load_doc_map(self.orch_dir)
+        self.assertEqual(len(m["categories"]), 11)
+        self.assertEqual(len(m["slots"]), 40)
+        cat_ids = {c["id"] for c in m["categories"]}
+        for slot in m["slots"]:
+            self.assertIn(slot["category"], cat_ids)        # every slot categorized
+            self.assertIsNone(slot["owner_section"])        # unowned at 5.1 (5.3)
+            self.assertIn("min_chars", slot)                # field present for 5.4
+        # slot ids are unique
+        self.assertEqual(len({s["slot_id"] for s in m["slots"]}), 40)
+
+
 if __name__ == "__main__":
     unittest.main()
diff --git a/tests/test_sections_documentation.py b/tests/test_sections_documentation.py
new file mode 100644
index 0000000..dd2111f
--- /dev/null
+++ b/tests/test_sections_documentation.py
@@ -0,0 +1,172 @@
+"""V3 board 5.0: the Documentation section — a pure-data manifest under
+sections/documentation/ that loads, lints, and serves its gap-fill contract
+through the EXISTING render path, with zero core-code changes.
+
+The section is deliberately NOT in sections._BUILTINS: it lives on disk and is
+discovered by the loader/list_sections, proving a real section can ship as data
+alone. These tests pin the four acceptance seams the card names — manifest
+parses under the loader, corrupt-file fallback raises the visible banner,
+workflow loads via load_workflow semantics, and the contract round-trips
+through schemas.extract_structured_blocks into docs._phase_section — plus a
+registry-integrity guard (the card's example types 'doc_section'/'spec' do not
+exist in artifact_types.json; only real types may be declared).
+"""
+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+import docs
+import events as evlib
+import schemas
+import sections as seclib
+
+HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+SECTION = "documentation"
+
+
+class TestDocumentationManifest(unittest.TestCase):
+    """The shipped manifest loads clean and serves its layers from JSON alone."""
+
+    def setUp(self):
+        self.app = tempfile.mkdtemp(prefix="orch_docsec_")
+        self.addCleanup(shutil.rmtree, self.app, True)
+
+    def _banners(self):
+        return evlib.read_events(self.app, kinds=["config_fallback"])
+
+    def test_loads_with_zero_banners_and_inline_workflow(self):
+        s = seclib.load_section(SECTION, HERE, app_dir=self.app)
+        self.assertEqual(s.id, "documentation")
+        self.assertEqual(s.title, "Documentation")
+        # An inline workflow object, not a named workflows/*.json file.
+        self.assertEqual(s.workflow_name, "(inline)")
+        self.assertEqual([p.key for p in s.workflow.phases],
+                         ["doc_gap_fill", "doc_coherence"])
+        self.assertEqual(self._banners(), [],
+                         "the shipped manifest must load with ZERO banners")
+
+    def test_not_a_builtin_but_discovered_on_disk(self):
+        # "Zero core-code changes": documentation is NOT seeded into _BUILTINS,
+        # yet list_sections finds it via its on-disk section.json.
+        self.assertNotIn(SECTION, seclib._BUILTINS)
+        self.assertIn(SECTION, seclib.list_sections(HERE))
+
+    def test_workflow_is_non_writing_non_conversational(self):
+        # A docs section assembles published artifacts; it must never gain
+        # build/write capability or block on a human inbox by accident.
+        s = seclib.load_section(SECTION, HERE)
+        self.assertIsNone(s.workflow.build_phase)
+        for p in s.workflow.phases:
+            self.assertFalse(p.writes, "%s must not write" % p.key)
+            self.assertFalse(p.conversational,
+                             "%s must not be conversational" % p.key)
+            self.assertTrue(p.roles, "%s must cast a roster" % p.key)
+
+    def test_lints_error_free(self):
+        report = seclib.lint_section(SECTION, HERE)
+        self.assertEqual([e for e in report if e["severity"] == "error"], [],
+                         "documentation must lint error-free: %r" % report)
+
+    def test_editorial_cast_replaces_pool_and_functional_cast_resolves(self):
+        import roles as roleslib
+        p, r = roleslib.load_roles_layered(
+            HERE, section_dir=os.path.join(HERE, "sections", SECTION))
+        self.assertEqual([x["id"] for x in p],
+                         ["archivist", "editor", "synthesist"],
+                         "documentation debates with its own editorial cast")
+        # The roles pool is NOT overridden -> inherits the global functional
+        # roles, and every phase's cast must resolve against that pool.
+        role_ids = {x["id"] for x in r}
+        for phase in seclib.load_section(SECTION, HERE).workflow.phases:
+            for rid in (phase.roles or []):
+                self.assertIn(rid, role_ids,
+                              "phase cast %r must resolve in the inherited "
+                              "pool" % rid)
+
+
+class TestDocumentationContract(unittest.TestCase):
+    """The doc_gap_fill contract overlays the shipped defaults and its output
+    round-trips through the existing extraction + render path (docs.py)."""
+
+    def test_contract_overlays_and_wires_into_wrapup(self):
+        cons = seclib.load_contracts(HERE, section=SECTION)
+        dgf = [c for c in cons if c["phase_key"] == "doc_gap_fill"]
+        self.assertEqual(len(dgf), 1, "exactly one doc_gap_fill contract")
+        self.assertEqual(dgf[0]["fence_tag"], "phase-output-json")
+        # required_fields names a REAL schemas.REQUIRED_FIELDS key, so the
+        # publication snippet and any extraction call can never drift.
+        self.assertEqual(schemas.REQUIRED_FIELDS[dgf[0]["required_fields"]],
+                         ["phase", "doc_sections"])
+        # The overlay ADDS without dropping the engine-gated defaults.
+        self.assertTrue(any(c["phase_key"] == "@summary" for c in cons))
+        # The snippet is actually assembled into the phase's wrap-up prompt.
+        assembled = seclib.assemble_contract(
+            cons, "doc_gap_fill", "research", include_decisions=False)
+        self.assertIn("phase-output-json", assembled)
+
+    def test_output_round_trips_through_extraction_and_render(self):
+        sample = (
+            "prose the agent wrote\n"
+            "```phase-output-json\n"
+            '{"phase": "doc_gap_fill", "doc_sections": '
+            '{"overview.summary": "TeaTimer brews the perfect cup.", '
+            '"architecture.storage": "SwiftData persists the timers."}}\n'
+            "```\n")
+        blocks = schemas.extract_structured_blocks(
+            sample, "phase-output-json",
+            required_fields=schemas.REQUIRED_FIELDS["phase_structured_output"])
+        self.assertEqual(len(blocks), 1)
+        self.assertEqual(set(blocks[0]["doc_sections"]),
+                         {"overview.summary", "architecture.storage"})
+        # docs._phase_section is the exact path the renderer uses per phase.
+        rendered = docs._phase_section("Documentation", sample)
+        self.assertIn("TeaTimer brews the perfect cup.", rendered)
+        self.assertIn("SwiftData persists the timers.", rendered)
+
+
+class TestDocumentationFallback(unittest.TestCase):
+    """A corrupt manifest fails CLOSED with exactly one visible banner — since
+    documentation is not a builtin, its default carries no bus capability."""
+
+    def setUp(self):
+        self.orch = tempfile.mkdtemp(prefix="orch_docsec_orch_")
+        self.app = tempfile.mkdtemp(prefix="orch_docsec_app_")
+        self.addCleanup(shutil.rmtree, self.orch, True)
+        self.addCleanup(shutil.rmtree, self.app, True)
+
+    def test_corrupt_manifest_fails_closed_with_one_banner(self):
+        path = seclib.section_path(SECTION, self.orch)
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, "w", encoding="utf-8") as fh:
+            fh.write("{ not valid json at all")
+        s = seclib.load_section(SECTION, self.orch, app_dir=self.app)
+        self.assertEqual(s.id, "documentation")
+        self.assertEqual(s.artifact_types_emitted, [],
+                         "a corrupt custom section must not inherit bus caps")
+        self.assertEqual(s.artifact_types_accepted, [])
+        evts = evlib.read_events(self.app, kinds=["config_fallback"])
+        self.assertEqual(len(evts), 1, "exactly one banner per substitution")
+        self.assertEqual(evts[0]["section"], "documentation")
+        self.assertIn("section.json", evts[0]["file"])
+
+
+class TestDocumentationRegistryIntegrity(unittest.TestCase):
+    """Every artifact type the section declares must be a REAL registered type.
+    Guards the card's stale example (doc_section/spec are not in the registry)
+    and any future removal of a type documentation depends on."""
+
+    def test_declared_types_exist_in_the_registry(self):
+        with open(os.path.join(HERE, "artifact_types.json"),
+                  encoding="utf-8") as fh:
+            registered = set(json.load(fh)["types"])
+        s = seclib.load_section(SECTION, HERE)
+        for t in s.artifact_types_emitted + s.artifact_types_accepted:
+            self.assertIn(t, registered,
+                          "documentation declares unregistered artifact "
+                          "type %r" % t)
+
+
+if __name__ == "__main__":
+    unittest.main()
