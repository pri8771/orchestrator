+        "bytes": bytes_,
+        "variant": "silent_tts_free",
+        "format": {
+            "duration_seconds": 12,
+            "width": 1080,
+            "height": 1920,
+            "fps": 30,
+            "codec": "H.264/avc1",
+            "audio": "none (video-only silent MP4; audio_tracks=0)",
+        },
+        "claim_cards": [
+            {"claim": s["label"] + ": " + s["value"], "source": s["authority"], "checked": True}
+            for s in pkt["sources"]
